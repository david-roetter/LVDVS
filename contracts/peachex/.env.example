# Copy to contracts/peachex/.env (ignored by Git) and fill in on your own machine only.
# Never commit, paste into chat, or screenshot the filled-in file.
SEPOLIA_RPC_URL=
# A fresh testnet-only account holding only Sepolia test ETH. Never reuse a key that has mainnet funds.
PEACHEX_DEPLOYER_PRIVATE_KEY=
# Receives the whole initial PCHX supply and Genesis #1. Preferably a Sepolia Safe.
TREASURY=
# Set to true only to allow a plain (non-contract) testnet treasury address.
PEACHEX_ALLOW_EOA_TREASURY=false
# Free key from etherscan.io (API v2 covers Sepolia); used only by the "verify" step.
ETHERSCAN_API_KEY=
