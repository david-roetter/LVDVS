# Optional local environment: node --env-file=.env src/server.js
PORT=3000
NODE_ENV=development
LUDUS_DATA_DIR=./data
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
LUDUS_AI_ENABLED=false
LUDUS_AI_PROVIDER=auto
LUDUS_DEMO=false
# No public deployment exists yet. Keep disabled until all values are verified.
PEACHEX_MODE=disabled
# Only Sepolia (11155111) or a local test chain (31337) is supported.
# PEACHEX_CHAIN_ID=11155111
# PEACHEX_RPC_URL=https://your-sepolia-rpc
# PEACHEX_TOKEN_ADDRESS=
# PEACHEX_ANCHOR_ADDRESS=
# KECCAK256 of the deployed runtime bytecode, not the compiler artifact.
# PEACHEX_TOKEN_CODEHASH=
# PEACHEX_ANCHOR_CODEHASH=
PEACHEX_CONFIRMATIONS=3
# Store real values only in a deployment secret manager or a gitignored .env.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GWDG_API_KEY=
# GWDG_ARCANA_ID=
# GWDG_MODEL=
# LUDUS_AI_ACCESS_TOKEN=
# LUDUS_BACKUP_TOKEN=
