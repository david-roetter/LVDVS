# Optional local environment: node --env-file=.env src/server.js
PORT=3000
NODE_ENV=development
LUDUS_DATA_DIR=./data
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
LUDUS_AI_ENABLED=false
LUDUS_AI_PROVIDER=auto
